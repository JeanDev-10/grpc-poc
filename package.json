{
  "name": "test-grpc",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "gen:types": "proto-loader-gen-types --longs=String --enums=String --defaults --oneofs --grpcLib=@grpc/grpc-js --outDir=packages/common/src/generated inventory/v1/inventory.proto orders/v1/orders.proto notifications/v1/notifications.proto --includeDirs=proto",
    "dev:orders": "tsx packages/orders/src/server.ts",
    "dev:notifications": "tsx packages/notifications/src/server.ts",
    "dev:inventory": "tsx packages/inventory/src/server.ts",
    "client": "tsx packages/client/src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.0",
    "@grpc/proto-loader": "^0.7.13",
    "jsonwebtoken": "^9.0.3",
    "protobufjs": "^7.6.6"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
